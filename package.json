{
  "name": "giordanna-pereira-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Portfólio de Giordanna Pereira, arquiteta e urbanista",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build && pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@sveltia/cms": "^0.252.0",
    "astro": "^7.4.4",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@mdn/mdn-http-observatory": "1.7.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.152.0"
  }
}
