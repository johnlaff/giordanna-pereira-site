# Headers de segurança de toda resposta do site estático (ADR 0005); a do Worker, em
# `src/contato/receber.ts`, leva a mesma lista. A CSP não mora aqui: ela sai do Astro, numa
# meta tag por página, com o hash de cada script e estilo do build. O adapter da Cloudflare
# põe no topo deste arquivo, no build, o cache imutável de /_astro/*.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# O Worker responde também no workers.dev (e nas URLs de preview, que são subdomínios dele). É o
# mesmo site, e o buscador não deve indexá-lo: o endereço do site é o domínio (ADR 0007).
https://:worker.:conta.workers.dev/*
  X-Robots-Tag: noindex
