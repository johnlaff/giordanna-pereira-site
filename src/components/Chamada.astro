---
/** O convite que fecha a home: uma frase e o caminho para a Grade de projetos. */
import { chamada } from '../config';
import Icone from './Icone.astro';
---

<section class="shell cta rv">
  <h2>
    {chamada.titulo} <em>{chamada.destaque}</em>
  </h2>
  <a class="btn" href={chamada.href}>
    {chamada.rotulo}
    <Icone nome="seta" />
  </a>
</section>

<style>
  .cta {
    padding: clamp(70px, 12vh, 130px) 0;
    text-align: center;
  }
  .cta h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-cta);
    line-height: 1.1;
    max-width: 18ch;
    margin: 0 auto 28px;
  }
  .cta h2 em {
    font-style: normal;
    color: var(--ink-soft);
  }
</style>
