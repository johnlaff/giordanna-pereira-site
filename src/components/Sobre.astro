---
/**
 * Sobre: o retrato, a apresentação e a grade de credenciais, na faixa escura da home.
 *
 * A moldura do retrato é um pseudo-elemento deslocado que vive atrás da foto (`z-index: -1`).
 * Sem um contexto de empilhamento próprio ela cairia atrás do fundo da seção e sumiria — daí
 * o `isolation: isolate` no bloco da foto, que prende o `-1` ali dentro.
 */
import { Picture } from 'astro:assets';
import retrato from '../assets/retrato-cv.webp';
import { sobre } from '../config';
import { qualidadeDeImagem } from '../imagens';
---

<section class="about" id="sobre">
  <div class="shell">
    <div class="about-grid">
      <div class="about-photo rv">
        <Picture
          src={retrato}
          formats={['avif']}
          fallbackFormat="webp"
          quality={qualidadeDeImagem}
          widths={[340, 520, 778]}
          sizes="(max-width: 820px) 340px, 34vw"
          alt={sobre.retratoAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="rv">
        <h2>
          {sobre.titulo} <em>{sobre.destaque}</em>
        </h2>
        {sobre.paragrafos.map((paragrafo) => (
          <p>{paragrafo}</p>
        ))}
        <dl class="cred">
          {sobre.credenciais.map((credencial) => (
            <div>
              <dt>{credencial.rotulo}</dt>
              <dd>
                {credencial.texto.map((linha, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {linha}
                  </Fragment>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--navy);
    color: var(--paper);
    position: relative;
    overflow: clip;
    padding: var(--sp-sec) var(--gutter);
  }
  .about .shell {
    padding-inline: 0;
  }
  /* Os dois círculos que quebram a faixa escura: um cheio no alto, um só de traço embaixo. */
  .about::before,
  .about::after {
    content: '';
    position: absolute;
    width: 46vw;
    height: 46vw;
    max-width: 560px;
    max-height: 560px;
    border-radius: 50%;
    pointer-events: none;
  }
  .about::before {
    background: var(--navy-deep);
    right: -12vw;
    top: -18vw;
  }
  .about::after {
    left: -14vw;
    bottom: -24vw;
    border: 1px solid rgba(205, 188, 164, 0.25);
  }
  .about-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .about-photo {
    position: relative;
    isolation: isolate;
  }
  /* O retrato ocupa a coluna inteira e mantém a própria proporção: a largura manda, a altura
     segue. Sem isto o `height` que o Astro escreve no atributo vira altura real e a foto
     estica. */
  .about-photo :global(img) {
    width: 100%;
    height: auto;
  }
  .about-photo::after {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1px solid rgba(205, 188, 164, 0.4);
    z-index: -1;
  }
  .about h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-about);
    line-height: 1.12;
    margin-bottom: 22px;
  }
  .about h2 em {
    color: var(--sand);
    font-style: normal;
  }
  .about p {
    color: rgba(242, 239, 233, 0.82);
    max-width: 56ch;
    margin-bottom: 16px;
    font-size: 17px;
  }
  .cred {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(242, 239, 233, 0.14);
    border: 1px solid rgba(242, 239, 233, 0.14);
    margin-top: 26px;
  }
  .cred > div {
    background: var(--navy);
    padding: 16px 18px;
  }
  .cred dt {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
    font-weight: 500;
    margin-bottom: 5px;
  }
  .cred dd {
    font-size: 15px;
    color: rgba(242, 239, 233, 0.9);
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-photo {
      max-width: 340px;
    }
  }
  @media (max-width: 640px) {
    .cred {
      grid-template-columns: 1fr;
    }
  }
</style>
