---
/**
 * Ícones de linha do site (traço 1.6, cantos arredondados): os quatro Contatos e a seta dos
 * botões. O SVG herda a cor do texto; o tamanho vem de quem usa. Decorativo: quem precisa de
 * rótulo põe no link.
 */
import type { TipoContato } from '../config';

export type NomeDeIcone = TipoContato | 'seta';

interface Props {
  nome: NomeDeIcone;
}

const { nome } = Astro.props;

const tracos: Record<NomeDeIcone, string> = {
  whatsapp:
    '<path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1L4 20z"/><path d="M9.6 8.4l1 2.1-1 1a5.4 5.4 0 0 0 2.9 2.9l1-1 2.1 1-.3 1.5c-.4.5-1 .7-1.7.6a8 8 0 0 1-6.1-6.1c-.1-.7.1-1.3.6-1.7z"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
  behance:
    '<path d="M3 7h4.5a2.3 2.3 0 0 1 0 4.6H3zM3 11.6h5a2.6 2.6 0 0 1 0 5.2H3zM14 6.5h5M13.5 13.5h7a3.5 3.5 0 1 0-.9 2.6M13.5 13.5a3.5 3.5 0 0 0 .9 2.6"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  seta: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
---

<svg viewBox="0 0 24 24" aria-hidden="true" set:html={tracos[nome]} />

<style>
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
