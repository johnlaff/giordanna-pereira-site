---
/**
 * Cabeçalho fixo. Sobre o hero da home ele começa transparente e fica sólido ao rolar;
 * nas demais páginas (e sem hero) é sólido desde o servidor, sem depender de JavaScript.
 */
import Marca from './Marca.astro';

export type Secao = 'home' | 'projetos' | 'contato';

interface Props {
  secao?: Secao | undefined;
  hero?: boolean;
}

const { secao, hero = false } = Astro.props;

const itens: { secao: Secao; href: string; rotulo: string }[] = [
  { secao: 'home', href: '/', rotulo: 'Home' },
  { secao: 'projetos', href: '/projetos', rotulo: 'Projetos' },
  { secao: 'contato', href: '/contato', rotulo: 'Contato' },
];
---

<a class="skip" href="#main">
  Pular para o conteúdo
</a>
<header class:list={['hdr', { solid: !hero }]} id="hdr" data-hero={hero ? '' : undefined}>
  <Marca linha="cau" rotulo="Início — Giordanna Pereira" />
  <nav class="nav" aria-label="Navegação principal">
    {itens.map((item) => (
      <a href={item.href} aria-current={item.secao === secao ? 'page' : undefined}>
        {item.rotulo}
      </a>
    ))}
  </nav>
</header>

<script>
  // Sobre o hero, o fundo só aparece depois de 40 px de rolagem.
  const hdr = document.getElementById('hdr');
  if (hdr?.hasAttribute('data-hero')) {
    const sync = () => hdr.classList.toggle('solid', scrollY > 40);
    sync();
    addEventListener('scroll', sync, { passive: true });
  }
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    -webkit-tap-highlight-color: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px var(--gutter);
    color: var(--paper);
    background: transparent;
    transition:
      background 0.35s var(--ease),
      box-shadow 0.35s;
  }
  .hdr.solid {
    background: rgba(35, 45, 56, 0.97);
    box-shadow: 0 1px 0 rgba(242, 239, 233, 0.08);
  }
  .hdr :global(:focus-visible) {
    outline-color: var(--sand);
  }
  .nav {
    display: flex;
    gap: clamp(14px, 3vw, 34px);
  }
  .nav a {
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.82;
    padding: 8px 2px;
    position: relative;
    transition: opacity 0.25s;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 4px;
    height: 1px;
    background: var(--sand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    opacity: 1;
  }
  .nav a:active {
    opacity: 0.7;
  }
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .hdr {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 12px var(--gutter);
    }
    .nav {
      width: 100%;
      gap: 22px;
    }
    .nav a {
      font-size: 11px;
      letter-spacing: 0.16em;
    }
  }
</style>
