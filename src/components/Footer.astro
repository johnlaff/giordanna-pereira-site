---
/** Rodapé: marca, CAU, os quatro Contatos como ícones e a linha de direitos. */
import { contatos, marca, site } from '../config';
import Icone from './Icone.astro';
import Marca from './Marca.astro';

const ano = new Date().getFullYear();
---

<footer class="ftr">
  <div class="shell">
    <div class="ftr-grid">
      <div class="ftr-brand">
        <Marca linha="area" />
      </div>
      <div class="ftr-cau">
        <b>{marca.cau}</b>
      </div>
      <div class="ftr-right">
        <div class="ftr-soc">
          {contatos.map((c) => (
            <a
              href={c.href}
              target={c.externo ? '_blank' : undefined}
              rel={c.externo ? 'noopener' : undefined}
              aria-label={c.rotulo}
              title={c.rotulo}
            >
              <Icone nome={c.tipo} />
              <span>{c.rotulo}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="ftr-bottom">
      <span>
        © {ano} {site.nome}
      </span>
      <span class="rights">Todos os direitos reservados</span>
      <a href="/contato">Política de privacidade</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    flex: none;
    background: var(--navy-deep);
    color: var(--paper);
    position: relative;
    overflow: clip;
    padding: 0 var(--gutter);
  }
  .ftr :global(:focus-visible) {
    outline-color: var(--sand);
  }
  .ftr .shell {
    padding-inline: 0;
  }
  .ftr::before {
    content: '';
    position: absolute;
    width: 30vw;
    height: 30vw;
    max-width: 360px;
    max-height: 360px;
    border-radius: 50% 50% 0 50%;
    background: var(--navy);
    right: -8vw;
    bottom: -14vw;
    opacity: 0.7;
    pointer-events: none;
  }
  .ftr-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: clamp(24px, 4vw, 60px);
    padding: 28px 0 22px;
    align-items: center;
  }
  .ftr-brand {
    display: flex;
    flex-direction: column;
    gap: 0;
    color: var(--paper);
  }
  .ftr-cau {
    text-align: center;
  }
  .ftr-cau b {
    display: block;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgba(242, 239, 233, 0.85);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .ftr-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
  }
  .ftr-soc {
    display: flex;
    gap: 4px;
  }
  .ftr-soc a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: rgba(242, 239, 233, 0.75);
    border-radius: 50%;
    transition:
      color 0.3s,
      background 0.3s;
  }
  .ftr-soc a:hover {
    color: var(--paper);
    background: rgba(242, 239, 233, 0.08);
  }
  .ftr-soc :global(svg) {
    width: 17px;
    height: 17px;
  }
  .ftr-soc a span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .ftr-bottom {
    position: relative;
    border-top: 1px solid var(--line-light);
    padding: 16px 0 22px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px 22px;
    flex-wrap: wrap;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: rgba(242, 239, 233, 0.72);
    text-align: center;
  }
  .ftr-bottom a {
    color: inherit;
    text-decoration: none;
    display: inline-block;
    padding: 4px 0;
    line-height: inherit;
    transition: color 0.25s;
  }
  .ftr-bottom > span {
    display: inline-block;
    padding: 4px 0;
  }
  .ftr-bottom a:hover {
    color: var(--paper);
  }
  .ftr-bottom .rights::before {
    content: '·';
    margin-right: 22px;
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    .ftr-bottom {
      flex-direction: column;
      gap: 6px;
    }
    .ftr-bottom .rights::before {
      content: none;
    }
  }
  @media (max-width: 820px) {
    .ftr-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      gap: 14px;
      padding: 24px 0 18px;
    }
    .ftr-brand,
    .ftr-right {
      align-items: center;
    }
  }
</style>
