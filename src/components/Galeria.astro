---
/**
 * Galeria de um Projeto: renders primeiro, pranchas por último, na ordem do conteúdo.
 * Quando a primeira imagem é paisagem, ela abre a galeria na largura toda, sem nunca passar de
 * meia largura em altura; as demais entram em linhas justificadas — todas ocupam a largura
 * toda, com a mesma altura dentro da linha (`galeria.linhas.ts`). Sem imagem nenhuma, a seção
 * mostra o estado Em breve. Cada imagem abre em tela cheia no lightbox, com zoom.
 *
 * O arranjo depende da largura medida no navegador: até ele rodar, e sem JavaScript, as
 * imagens ficam em duas colunas na proporção original — uma só abaixo de 640 px.
 *
 * Cada imagem sai em AVIF com alternativa WebP, em variantes por largura que o navegador
 * escolhe pelo `sizes` — abaixo, a largura aproximada que cada uma ocupa em cada faixa de tela.
 * As variantes param em 2560 px; uma imagem maior que isso, como uma prancha em alta, entra no
 * lightbox também inteira, em WebP sem perda, e é ela que o zoom carrega quando a variante não
 * basta (ADR 0015).
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import 'photoswipe/style.css';
import {
  larguraMaximaDasVariantes,
  largurasDasVariantes,
  qualidadeDeImagem,
  qualidadeSemPerda,
} from '../imagens';
import EmBreve from './EmBreve.astro';
import { porFaixa } from './galeria.linhas';

interface Props {
  imagens: ImageMetadata[];
  /** Nome do Projeto, usado no texto alternativo de cada imagem e na legenda do lightbox. */
  titulo: string;
}

const { imagens, titulo } = Astro.props;

/**
 * A Abertura carrega de imediato — é a imagem que mede o carregamento da página — e as demais
 * só ao se aproximarem da tela, quando o arranjo já mediu a caixa de cada uma e o navegador
 * pede a variante certa. Carregá-las cedo pediria a variante pela estimativa abaixo, que para
 * um retrato numa linha cheia chega a ser o dobro do necessário.
 */
const LARGURA_TOTAL = porFaixa([
  ['(min-width: 1240px)', '1136px'],
  ['(min-width: 1100px)', 'calc(100vw - 104px)'],
  ['(min-width: 700px)', 'calc(100vw - 80px)'],
  ['', 'calc(100vw - 48px)'],
]);
const METADE = porFaixa([
  ['(min-width: 1240px)', '559px'],
  ['(min-width: 1100px)', 'calc((100vw - 122px) / 2)'],
  ['(min-width: 700px)', 'calc((100vw - 90px) / 2)'],
  ['(min-width: 641px)', 'calc((100vw - 58px) / 2)'],
  ['', 'calc(100vw - 48px)'],
]);

/** A imagem inteira, sem perda, de quem é maior que as variantes: é o que o zoom profundo carrega. */
const inteiras = await Promise.all(
  imagens.map(async (imagem) =>
    imagem.width > larguraMaximaDasVariantes
      ? (await getImage({ src: imagem, format: 'webp', quality: qualidadeSemPerda })).src
      : undefined,
  ),
);

const abreEmFaixa = imagens[0] !== undefined && imagens[0].width > imagens[0].height;
---

{/* Sem esta âncora, quem navega por títulos pula do "Detalhes do projeto" ao rodapé
  sem encontrar a galeria, que é o conteúdo central da página. */}
<h2 class="sr">Galeria</h2>
{/* Cada imagem já se anuncia ao leitor de tela pelo próprio rótulo; esta linha é a pista
  visual de quem não tem cursor para descobrir o mesmo. Ela promete abrir e ampliar, e não
  tela cheia: numa tela em pé, um render deitado abre pouco maior que a miniatura, e o
  tamanho vem do gesto seguinte. */}
{imagens.length > 0 && (
  <p class="toque" aria-hidden="true">
    Toque numa imagem para abrir e ampliar
  </p>
)}
{imagens.length > 0 ? (
  <div class="gal" data-titulo={titulo}>
    {imagens.map((imagem, i) => (
      <button
        type="button"
        class:list={['item', { abertura: i === 0 && abreEmFaixa }]}
        data-proporcao={(imagem.width / imagem.height).toFixed(4)}
        data-inteira={inteiras[i]}
        data-largura={imagem.width}
        data-altura={imagem.height}
        aria-label={`Abrir imagem ${i + 1} de ${imagens.length} em tela cheia`}
      >
        <Picture
          src={imagem}
          width={Math.min(imagem.width, larguraMaximaDasVariantes)}
          widths={largurasDasVariantes(imagem.width)}
          formats={['avif']}
          fallbackFormat="webp"
          quality={qualidadeDeImagem}
          sizes={i === 0 && abreEmFaixa ? LARGURA_TOTAL : METADE}
          alt={`${titulo} — imagem ${i + 1}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </button>
    ))}
  </div>
) : (
  <div class="sem-imagens">
    <EmBreve />
  </div>
)}

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import { DENSIDADE_SEM_RETINA, TELA_ESTREITA, linhasDaGaleria } from './galeria.linhas';

  const galeria = document.querySelector<HTMLElement>('.gal');
  if (galeria !== null) {
    const itens = [...galeria.querySelectorAll<HTMLElement>('.item')];
    const proporcoes = itens.map((item) => Number(item.dataset.proporcao));
    const titulo = galeria.dataset.titulo ?? '';
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)');
    /** Sem retina, a imagem pedida é uma vez e meia a caixa — o mesmo que o `sizes` do HTML faz. */
    const densidade = () => (devicePixelRatio < 1.5 ? DENSIDADE_SEM_RETINA : 1);

    /* ===== arranjo em linhas justificadas ===== */
    let larguraArranjada = 0;
    const arranjar = () => {
      const largura = galeria.clientWidth;
      // Só a largura muda o arranjo; sem esta guarda, a altura que ele mesmo produz
      // realimentaria o observador.
      if (largura === larguraArranjada) return;
      larguraArranjada = largura;
      const linhas = linhasDaGaleria(proporcoes, {
        largura,
        gap: parseFloat(getComputedStyle(galeria).columnGap) || 0,
        abertura: itens[0]?.classList.contains('abertura') ?? false,
      });
      for (const caixa of linhas.flat()) {
        const item = itens[caixa.indice]!;
        item.style.width = `${caixa.largura}px`;
        item.style.height = `${caixa.altura}px`;
        // A proporção da imagem e o `max-height` são o andaime de quem não tem JavaScript; com
        // o arranjo medido, quem manda é a altura calculada, que pode passar de meia largura
        // para não recortar demais.
        item.style.maxHeight = 'none';
        // Só o arranjo sabe a caixa de cada imagem: uma sozinha na linha ocupa a Galeria
        // inteira, e o `sizes` do HTML, escrito antes de saber disso, pediria uma variante
        // pequena demais. Com a medida exata, o navegador escolhe a que a caixa justifica.
        const pedido = `${Math.round(caixa.largura * densidade())}px`;
        for (const fonte of item.querySelectorAll<HTMLImageElement | HTMLSourceElement>(
          'img, source',
        ))
          fonte.sizes = pedido;
        // O lightbox anima a partir da miniatura e precisa saber se ela mostra a imagem inteira.
        item.dataset.cortada = caixa.cortada ? 'true' : '';
      }
    };
    arranjar();
    new ResizeObserver(arranjar).observe(galeria);

    /* ===== lightbox ===== */
    const lightbox = new PhotoSwipeLightbox({
      gallery: galeria,
      children: '.item',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 1,
      loop: true,
      wheelToZoom: true,
      initialZoomLevel: 'fit',
      // Ampliar enche a tela, e quando isso rende pouco — um retrato numa tela em pé — vai
      // pelo menos a duas vezes e meia o ajuste. O teto é o tamanho real do arquivo em
      // `src/assets/` — numa prancha em 7680 px, cinco vezes a tela do notebook, o bastante
      // para ler a cota —: além dele, o que cresce é o artefato do arquivo, não a informação.
      secondaryZoomLevel: (zoom) => Math.min(Math.max(zoom.fill, zoom.fit * 2.5), 1),
      maxZoomLevel: 1,
      imageClickAction: 'zoom',
      doubleTapAction: 'zoom',
      tapAction: 'toggle-controls',
      // Em tela estreita a imagem vai de borda a borda: os 20 px laterais custam 12% da
      // largura justamente onde ela é escassa, e a folga de cima e de baixo já separa a
      // imagem dos controles e da legenda.
      paddingFn: ({ x }) => ({
        top: 24,
        bottom: 64,
        left: x < TELA_ESTREITA ? 0 : 20,
        right: x < TELA_ESTREITA ? 0 : 20,
      }),
      easing: 'cubic-bezier(.32,.72,0,1)',
      showAnimationDuration: 380,
      hideAnimationDuration: 320,
      // A legenda já diz a posição; o contador do PhotoSwipe ficaria repetido.
      counter: false,
      closeTitle: 'Fechar',
      zoomTitle: 'Ampliar',
      arrowPrevTitle: 'Imagem anterior',
      arrowNextTitle: 'Próxima imagem',
      errorMsg: 'Não foi possível carregar esta imagem.',
    });

    // Quem prefere menos movimento abre a imagem sem a animação de zoom, e amplia sem transição.
    const ajustarMovimento = () => {
      lightbox.options.showHideAnimationType = semMovimento.matches ? 'none' : 'zoom';
      lightbox.options.zoomAnimationDuration = semMovimento.matches ? 0 : 300;
    };
    ajustarMovimento();
    semMovimento.addEventListener('change', ajustarMovimento);

    // Em tela cheia vale a maior variante que a tela justifica, no formato que o navegador
    // já escolheu para a miniatura: o `srcset` do lightbox é o mesmo do `<picture>` da página.
    // Uma imagem maior que as variantes entra nele também inteira, na largura real: o
    // navegador só a pede quando o zoom passa da maior variante.
    // Quem decide é a primeira imagem que já escolheu formato — numa rede lenta a Abertura
    // ainda pode estar carregando, e aí `currentSrc` está vazio e não diz nada.
    const aceitaAvif = () =>
      itens
        .map((item) => item.querySelector('img')?.currentSrc)
        .find((escolhida) => escolhida !== undefined && escolhida !== '')
        ?.endsWith('.avif') ?? false;
    lightbox.addFilter('domItemData', (item, elemento) => {
      const img = elemento.querySelector('img');
      const avif = elemento.querySelector<HTMLSourceElement>('source[type="image/avif"]');
      if (img === null) return item;
      const emAvif = aceitaAvif() && avif !== null;
      const largura = Number(elemento.dataset.largura);
      const { inteira } = elemento.dataset;
      const variantes = emAvif ? avif.srcset : img.srcset;
      return {
        ...item,
        src: img.src,
        srcset: inteira === undefined ? variantes : `${variantes}, ${inteira} ${largura}w`,
        width: largura,
        height: Number(elemento.dataset.altura),
        alt: img.alt,
        msrc: img.currentSrc || img.src,
        thumbCropped: elemento.dataset.cortada === 'true',
      };
    });

    // A imagem em tela cheia segue a mesma regra das miniaturas: sem retina, pede uma vez e
    // meia o tamanho exibido, e é onde isso mais rende — é a tela de examinar o render.
    lightbox.addFilter('srcsetSizesWidth', (largura) => largura * densidade());

    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'legenda',
        className: 'lb-legenda',
        appendTo: 'root',
        onInit: (elemento, pswp) => {
          const posicao = document.createElement('b');
          const projeto = document.createElement('span');
          projeto.textContent = titulo;
          elemento.append(posicao, projeto);
          const atualizar = () => {
            posicao.textContent = `${pswp.currIndex + 1} / ${pswp.getNumItems()}`;
          };
          pswp.on('change', atualizar);
          atualizar();
        },
      });
    });

    // Tabular a partir do último controle levaria o foco para fora do diálogo por um instante:
    // o PhotoSwipe o traz de volta, mas só depois de ele já ter passado pela página atrás.
    // Aqui o ciclo se fecha dentro do diálogo, como se espera de uma tela cheia modal.
    const circularOFoco = (dialogo: HTMLElement) => (evento: KeyboardEvent) => {
      if (evento.key !== 'Tab') return;
      const controles = [...dialogo.querySelectorAll('button')].filter(
        (botao) => !botao.disabled && getComputedStyle(botao).visibility !== 'hidden',
      );
      const ponta = evento.shiftKey ? controles[0] : controles.at(-1);
      if (ponta === undefined || document.activeElement !== ponta) return;
      evento.preventDefault();
      (evento.shiftKey ? controles.at(-1) : controles[0])?.focus();
    };

    lightbox.on('firstUpdate', () => {
      const dialogo = lightbox.pswp?.element;
      // O PhotoSwipe põe `role="dialog"`, mas quem usa leitor de tela precisa saber de qual
      // galeria é esta tela cheia, e que o resto da página está fora de alcance enquanto ela existe.
      dialogo?.setAttribute('aria-label', `Galeria em tela cheia: ${titulo}`);
      dialogo?.setAttribute('aria-modal', 'true');
      if (dialogo !== undefined) dialogo.addEventListener('keydown', circularOFoco(dialogo));
      document.body.classList.add('lock');
    });
    lightbox.on('destroy', () => document.body.classList.remove('lock'));

    // Esc entre o clique e a tela cheia no ar: o PhotoSwipe só atende ao fechamento depois que
    // a animação de abertura termina, e no primeiro clique ele ainda está baixando o módulo.
    // Nas duas janelas o pedido se perderia e a galeria abriria contra a vontade de quem pediu.
    document.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Escape') return;
      const pswp = lightbox.pswp;
      if (pswp === undefined) lightbox.shouldOpen = false;
      else if (!pswp.opener.isOpen) pswp.on('openingAnimationEnd', () => pswp.close());
    });

    lightbox.init();
  }
</script>

<style>
  /* Em tela de toque não há cursor nem hover para anunciar que a imagem abre: quem anuncia é
     esta linha, uma vez. Ela fala em voz corrente de propósito — a caixa alta com entreletra
     larga é o figurino dos rótulos da página, e uma instrução não é um rótulo. */
  .toque {
    display: none;
    margin-bottom: 14px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  @media (hover: none) {
    .toque {
      display: block;
    }
  }
  .gal {
    --ggap: clamp(10px, 1.6vw, 18px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ggap);
    align-content: flex-start;
    padding-bottom: clamp(50px, 8vh, 90px);
    /* A altura da Abertura se mede pela largura da galeria; por isso ela é o container de consulta. */
    container-type: inline-size;
  }
  .item {
    flex: 0 0 auto;
    width: calc(50% - var(--ggap) / 2);
    overflow: hidden;
    cursor: zoom-in;
    /* Enquanto a imagem não pinta, o espaço reservado é o mesmo cinza do fundo do render. */
    background: var(--img-bg);
  }
  /* O <picture> some do fluxo para a imagem preencher o item sem uma caixa intermediária. */
  .item :global(picture) {
    display: contents;
  }
  .item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* A caixa da linha justificada pode ser mais baixa que a imagem: ela entra centralizada. */
    object-fit: cover;
    transition: opacity 0.5s;
  }
  .item:hover :global(img) {
    opacity: 0.88;
  }
  /* A abertura ocupa a largura toda e nunca passa de meia largura em altura: uma imagem mais
     alta que 2:1 é recortada; uma já mais panorâmica mantém a proporção original. */
  .abertura {
    width: 100%;
    max-height: 50cqw;
  }
  @media (max-width: 640px) {
    .item {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .item :global(img) {
      transition: none;
    }
  }
  /* O Em breve ocupa a mesma faixa de abertura de uma Galeria com imagens; em telas estreitas,
     a altura mínima aproxima a faixa da proporção do Preview. A largura é explícita porque,
     sem ela, `aspect-ratio` deduziria a largura da altura mínima e transbordaria a tela. */
  .sem-imagens {
    width: 100%;
    aspect-ratio: 2 / 1;
    min-height: 220px;
    margin-bottom: clamp(50px, 8vh, 90px);
  }
</style>

<style is:global>
  /* O lightbox vive fora da página, em elemento próprio no fim do body: o estilo dele não
     pode ser escopado no componente. Fora daqui, tudo vem do CSS do PhotoSwipe. */
  .pswp {
    /* Preto puro: em tela cheia, qualquer cor ao redor contamina as cores do render. */
    --pswp-bg: #000;
    /* O branco dos controles e da legenda é o par do preto do fundo, não o --paper da marca. */
    --lb-frente: #fff;
    --pswp-root-z-index: 100;
    font-family: var(--font-sans);
  }
  /* Os controles são círculos discretos sobre a imagem, do mesmo tamanho nos quatro cantos. */
  .pswp__button--close,
  .pswp__button--zoom,
  .pswp__button--arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }
  .pswp__button--close,
  .pswp__button--zoom {
    margin: 14px 14px 0 0;
  }
  .pswp__button--arrow {
    top: 50%;
    left: 16px;
    margin-top: -26px;
    transition:
      background 0.3s,
      transform 0.3s;
  }
  .pswp__button--arrow--next {
    left: auto;
    right: 16px;
  }
  .pswp__button--close:hover,
  .pswp__button--zoom:hover,
  .pswp__button--arrow:hover {
    background: rgba(0, 0, 0, 0.7);
  }
  .pswp__button--arrow--prev:hover {
    transform: translateX(-3px);
  }
  .pswp__button--arrow--next:hover {
    transform: translateX(3px);
  }
  /* A seta é um chevron de duas bordas: a do PhotoSwipe é cheia e compete com a imagem. */
  .pswp__button--arrow .pswp__icn {
    display: none;
  }
  .pswp__button--arrow::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    border-left: 1.6px solid var(--lb-frente);
    border-bottom: 1.6px solid var(--lb-frente);
    transform: translate(-35%, -50%) rotate(45deg);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
  }
  .pswp__button--arrow--next::before {
    transform: translate(-65%, -50%) rotate(-135deg);
  }
  .pswp__icn {
    width: 26px;
    height: 26px;
    top: 13px;
    left: 13px;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
  }
  .pswp__button:focus-visible {
    outline: 2px solid var(--lb-frente);
    outline-offset: 2px;
  }
  .pswp__top-bar {
    height: 80px;
    background: none;
  }
  .lb-legenda {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    padding: 0 16px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lb-legenda b {
    margin-right: 14px;
    font-weight: 400;
    color: var(--lb-frente);
    font-variant-numeric: tabular-nums;
  }
  /* A legenda acompanha os controles: some junto com eles ao toque na imagem. */
  .pswp:not(.pswp--ui-visible) .lb-legenda {
    opacity: 0;
  }
  .pswp--ui-visible .lb-legenda {
    opacity: 1;
    transition: opacity 0.3s;
  }
  @media (max-width: 640px) {
    /* Alvo de toque de 44 px, com o ícone proporcionalmente menor dentro dele. */
    .pswp__button--close,
    .pswp__button--zoom {
      width: 44px;
      height: 44px;
      margin: 10px 10px 0 0;
    }
    .pswp__icn {
      width: 24px;
      height: 24px;
      top: 10px;
      left: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pswp--ui-visible .lb-legenda,
    .pswp__button--arrow {
      transition: none;
    }
    .pswp__button--arrow--prev:hover,
    .pswp__button--arrow--next:hover {
      transform: none;
    }
  }
</style>
