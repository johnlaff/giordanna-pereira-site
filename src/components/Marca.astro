---
/** Marca em texto: monograma em CSS + nome + linha secundária (CAU no cabeçalho, área no rodapé). */
import { marca } from '../config';

interface Props {
  linha: 'cau' | 'area';
  rotulo?: string;
}

const { linha, rotulo } = Astro.props;
---

<a class="brand" href="/" aria-label={rotulo}>
  <span class="mark" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </span>
  <span class="brand-txt">
    <span class="brand-name">{marca.nome}</span>
    <span class="brand-cau">{marca[linha]}</span>
  </span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .mark {
    width: 26px;
    height: 26px;
    position: relative;
    flex: none;
  }
  .mark i {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
  }
  .mark i:nth-child(1) {
    left: 0;
    top: 0;
    opacity: 0.55;
  }
  .mark i:nth-child(2) {
    right: 0;
    top: 0;
  }
  .mark i:nth-child(3) {
    left: 0;
    bottom: 0;
    border-radius: 0 0 0 12px;
  }
  .mark i:nth-child(4) {
    right: 0;
    bottom: 0;
    opacity: 0.35;
    border-radius: 0 0 12px 0;
  }
  .brand-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    text-align: left;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.02em;
  }
  .brand-cau {
    font-size: 11px;
    letter-spacing: 0.1em;
    opacity: 0.8;
    margin-top: 3px;
    font-weight: 400;
    padding-left: 0.1em;
  }
</style>
