---
/**
 * O Sveltia CMS, onde Giordanna cadastra Projetos e Depoimentos (ADR 0002). A página não usa o
 * `Base.astro`: o CMS ocupa a tela inteira, com a interface dele, e nada do site aparece aqui.
 *
 * A configuração vem de `src/admin/configuracao.ts`; o login passa pelo Worker do próprio site
 * (ADR 0014). O Sveltia vem do npm, e não do CDN que a documentação dele sugere: a versão é a
 * do lockfile, atualizada pelo Renovate. O arquivo dele entra no build como veio do pacote, sem
 * passar pelo empacotador: empacotado, ele levaria para um arquivo à parte o carregador de
 * módulos que o script da Galeria embute, e a Galeria esperaria mais uma ida à rede antes de
 * medir as imagens e dizer ao navegador que variante baixar.
 *
 * A CSP desta página é mais larga que a do site, e só ela (ADR 0014). O CMS fala com a API do
 * GitHub e busca no UNPKG a tradução da interface e o codificador de WebP do Safari, que
 * precisa de WebAssembly; as fontes da interface vêm do jsDelivr; e ele monta estilos em tempo
 * de execução, que não têm hash no build.
 */
import '../styles/tokens.css';
// O pacote só exporta o módulo; o script clássico, que expõe `window.CMS`, é pego pelo caminho.
import sveltia from '../../node_modules/@sveltia/cms/dist/sveltia-cms.js?url';

// Sem a CSP do `astro.config.ts` ligada, a página não teria política nenhuma: o build para.
const csp = Astro.csp;
if (csp === undefined) throw new Error('A página do CMS precisa da CSP do Astro (security.csp).');

csp.insertScriptResource('https://unpkg.com');
csp.insertScriptResource("'wasm-unsafe-eval'");
csp.insertStyleResource("'self'");
csp.insertStyleResource("'unsafe-inline'");
csp.insertDirective(
  "connect-src 'self' blob: data: https://api.github.com https://www.githubstatus.com https://unpkg.com",
);
csp.insertDirective("img-src 'self' blob: data: https://*.githubusercontent.com");
csp.insertDirective("font-src 'self' https://cdn.jsdelivr.net");
csp.insertDirective("media-src 'self' blob:");
csp.insertDirective('frame-src blob:');
csp.insertDirective("worker-src 'self' blob:");
csp.insertDirective("manifest-src 'self' blob:");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CMS · Giordanna Pereira</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <noscript>
      <p class="sem-js">
        O CMS precisa do JavaScript ligado no navegador. Ligue-o nas configurações e recarregue a
        página.
      </p>
    </noscript>
    <script>
      // O Sveltia fala a língua do navegador. Num celular em inglês, o CMS abriria em inglês:
      // enquanto quem entra não escolher outra língua nas preferências do CMS, vale o português.
      // A preferência precisa estar gravada antes de o Sveltia carregar, porque ele lê e grava
      // as preferências assim que o arquivo dele roda.
      try {
        const chave = 'sveltia-cms.prefs';
        const preferencias = JSON.parse(localStorage.getItem(chave) ?? '{}') as {
          locale?: string;
        };
        if (!preferencias.locale)
          localStorage.setItem(chave, JSON.stringify({ ...preferencias, locale: 'pt-BR' }));
      } catch {
        // Sem armazenamento local, fica a língua do navegador.
      }
      // Sem isto, o Sveltia se inicia sozinho e procura um `config.yml`.
      Object.assign(window, { CMS_MANUAL_INIT: true });
    </script>
    <!-- Os três scripts rodam na ordem em que aparecem: os módulos e o `defer` esperam juntos o
    fim da página. -->
    <script is:inline defer src={sveltia}></script>
    <script>
      import type { CmsConfig } from '@sveltia/cms';
      import { configuracaoDoCms } from '../admin/configuracao';

      const { CMS } = window as unknown as {
        CMS: { init: (opcoes: { config: CmsConfig }) => void };
      };
      // O login volta para a origem em que o CMS está aberto, que é a cadastrada no OAuth App
      // (o domínio, desde o #16).
      CMS.init({ config: configuracaoDoCms(location.origin) });
    </script>
  </body>
</html>

<style>
  /* Só o aviso sem JavaScript é do site; o resto da tela é a interface do Sveltia. */
  .sem-js {
    max-width: 36ch;
    margin: 20vh auto 0;
    padding: 0 24px;
    font:
      400 1.0625rem/1.6 system-ui,
      sans-serif;
    color: var(--ink);
    text-align: center;
  }
</style>
