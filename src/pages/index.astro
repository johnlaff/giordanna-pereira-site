---
import CTA from '../components/CTA.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Ferramentas from '../components/Ferramentas.astro';
import Hero from '../components/Hero.astro';
import Revelar from '../components/Revelar.astro';
import Sobre from '../components/Sobre.astro';
import { dadosDaPessoa, dadosDoWebSite } from '../compartilhamento/dados-estruturados';
import Base from '../layouts/Base.astro';

if (Astro.site === undefined)
  throw new Error('sem `site` em astro.config.ts, o JSON-LD não tem URL');
---

<Base
  secao="home"
  hero
  rota="/"
  dadosEstruturados={[dadosDaPessoa(Astro.site), dadosDoWebSite(Astro.site)]}
>
  <Revelar />
  <Hero />
  <Sobre />
  <Ferramentas />
  <Depoimentos />
  <CTA />
</Base>
