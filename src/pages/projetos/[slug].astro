---
import { getCollection } from 'astro:content';
import Ficha from '../../components/Ficha.astro';
import Galeria from '../../components/Galeria.astro';
import { ordenarProjetos, vizinhosNaOrdem } from '../../content.schema';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projetos = ordenarProjetos(await getCollection('projetos'));
  return projetos.map((projeto, i) => ({
    params: { slug: projeto.id },
    props: { projeto, vizinhos: vizinhosNaOrdem(projetos, i) },
  }));
}

const { projeto, vizinhos } = Astro.props;
const { titulo, tipo, descricao, ferramentas, galeria } = projeto.data;
---

<Base titulo={titulo} descricao={descricao} secao="projetos">
  <div class="shell">
    <div class="page-head">
      <h1>{titulo}</h1>
      <p class="kind">{tipo}</p>
    </div>
    <div class="proj-top">
      <div>
        <p class="lead">{descricao}</p>
        <ul class="chips" aria-label="Ferramentas usadas no projeto">
          {ferramentas.map((ferramenta) => (
            <li class="chip">{ferramenta}</li>
          ))}
        </ul>
      </div>
      <Ficha ficha={projeto.data} />
    </div>
    <Galeria imagens={galeria} titulo={titulo} />
    {vizinhos && (
      <nav class="pn" aria-label="Outros projetos">
        <a href={`/projetos/${vizinhos.anterior.id}`}>
          <small>Projeto anterior</small>
          <b>{vizinhos.anterior.data.titulo}</b>
        </a>
        <a class="next" href={`/projetos/${vizinhos.proximo.id}`}>
          <small>Próximo projeto</small>
          <b>{vizinhos.proximo.data.titulo}</b>
        </a>
      </nav>
    )}
  </div>
</Base>

<style>
  .proj-top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-bottom: clamp(36px, 6vh, 60px);
  }
  @media (max-width: 860px) {
    .proj-top {
      grid-template-columns: 1fr;
    }
  }
  .lead {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 58ch;
    margin-top: 18px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
    list-style: none;
  }
  .chip {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 13px;
    color: var(--ink-soft);
  }
  /* Navegação pela Ordem dos Projetos, circular: do último se volta ao primeiro. */
  .pn {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding: 26px 0 var(--sp-page);
  }
  .pn a {
    text-decoration: none;
    color: inherit;
    max-width: 46%;
  }
  .pn a small {
    display: block;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .pn a b {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--fs-pn);
    line-height: 1.1;
    transition: color 0.3s;
  }
  .pn a:hover b {
    color: var(--ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .pn a b {
      transition: none;
    }
  }
  .pn a.next {
    text-align: right;
    margin-left: auto;
  }
</style>
